{
  "name": "evoting-dapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install && npm install --prefix app",
    "dev": "node scripts/dev.js",
    "chain": "hardhat node --hostname 0.0.0.0",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "test": "hardhat test",
    "app": "npm start --prefix app",
    "share": "npx --yes cloudflared tunnel --url http://localhost:8545"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  }
}